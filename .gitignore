# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Node / Svelte / Vite (Frontend)
node_modules/
dist/
dist-ssr/
.svelte-kit/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.*
!.env.example

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Excludes all raw downloads, scraped pages, parsed JSON, and discovery logs
data/
backend/data/

# Scraped/generated data formats - scoped to data dirs only, not global
data/**/*.html
data/**/*.csv
data/**/*.json
data/**/*.xml
data/**/*.sqlite3
data/**/*.db

# Python packaging / build artifacts
*.egg-info/
build/
*.egg

# Coverage reports (if you ever run pytest --cov)
.coverage
htmlcov/
coverage.xml

# mypy / ruff / other tool caches
.mypy_cache/
.ruff_cache/