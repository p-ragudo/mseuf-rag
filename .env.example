DEVELOPMENT=true

TARGET_DOMAIN=https://site.com
TEST_TARGET_DOMAIN=https://site.com

HOST=https://example-host.com
PORT=8000

QDRANT_API_KEY=your_api_key
QDRANT_CLUSTER_ENDPOINT=https://example-endpoint.com

TEST_QDRANT_API_KEY=your_test_api_key
TEST_QDRANT_CLUSTER_ENDPOINT=https://example-test-endpoint.com

USE_TEST_QDRANT_DB=true // switch to false when working with production db
VECTOR_DB_PROVIDER=qdrant or qdrant_cloud_inference

DEFAULT_TOP_K=5
MIN_TOP_K=1
MAX_TOP_K=20

LLM_PROVIDER="gemini"
LLM_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-3.1-flash-lite